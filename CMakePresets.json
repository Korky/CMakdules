{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-debug",
      "description": "Debug build with LLVM/Clang on Windows",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_LINKER": "lld-link"
      }
    },
    {
      "name": "windows-release",
      "description": "Release build with LLVM/Clang on Windows",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_LINKER": "lld-link"
      }
    },
    {
      "name": "linux-debug",
      "description": "Debug build with LLVM/Clang on Linux",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_LINKER": "lld"
      }
    },
    {
      "name": "linux-release",
      "description": "Release build with LLVM/Clang on Linux",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_LINKER": "lld"
      }
    }
  ],
  "buildPresets": [
    { "name": "Windows-Debug", "configurePreset": "windows-debug" },
    { "name": "Windows-Release", "configurePreset": "windows-release" },
    { "name": "Linux-Debug", "configurePreset": "linux-debug" },
    { "name": "Linux-Release", "configurePreset": "linux-release" }
  ],
  "testPresets": [
    { "name": "Windows-Debug", "configurePreset": "windows-debug" },
    { "name": "Windows-Release", "configurePreset": "windows-release" },
    { "name": "Linux-Debug", "configurePreset": "linux-debug" },
    { "name": "Linux-Release", "configurePreset": "linux-release" }
  ]
}
